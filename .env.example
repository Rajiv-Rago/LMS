# ===================
# Required
# ===================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/kantigo

# Test database (used by Jest integration tests)
MONGODB_URI_TEST=mongodb://localhost:27017/kantigo-test

# JWT secret for authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secret-key-here

# Optional Auth.js secret. Defaults to JWT_SECRET when unset during Sprint 1.
AUTH_SECRET=

# OAuth providers for Auth.js sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# ===================
# AI Provider
# ===================

# Choose one: openai, anthropic, groq, cerebras, gemini
AI_PROVIDER=groq

# Set the API key for your chosen provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
GEMINI_API_KEY=

# ===================
# Storage
# ===================

# Storage provider: "local" (default) or "s3"
STORAGE_PROVIDER=local

# S3 configuration (required when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===================
# Job Queue
# ===================

# Enable async job queue (default: false, uses sync shim)
QUEUE_ENABLED=false

# Redis URL (optional, for future Redis-backed queue)
REDIS_URL=

# ===================
# Email
# ===================

# Email provider: "console" (default, logs to terminal), "resend", "sendgrid", "ses"
EMAIL_PROVIDER=console

# From address used in sent emails
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Resend (https://resend.com)
RESEND_API_KEY=

# SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# AWS SES — also requires AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY or IAM role)
# AWS_REGION=us-east-1

# ===================
# App
# ===================

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# App name shown in emails
APP_NAME=Kantigo

# ===================
# YouTube
# ===================

# YouTube Data API key (required for YouTube-based learning paths)
# Get one at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# ===================
# AI Rate Limiting
# ===================

# Enable daily AI usage limits per user (default: true)
# Set to "false" for self-hosted setups where you don't want usage restrictions
AI_RATE_LIMIT_ENABLED=true

# ===================
# Logging (Axiom)
# ===================

# Axiom persistent logging (https://axiom.co — free tier: 500MB/month)
# Create a dataset + API token at axiom.co, then fill these in.
# When not set, logs go to console only.
NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=

# ===================
# Optional
# ===================

# Override default AI model (leave empty to use provider default)
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
# Cerebras: llama-3.3-70b, llama-3.1-8b
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
AI_MODEL=

# JWT token expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Node environment
NODE_ENV=development
